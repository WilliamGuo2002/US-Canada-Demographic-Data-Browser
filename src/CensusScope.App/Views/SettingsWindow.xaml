<Window x:Class="CensusScope.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="U.S. Census API key"/>
            <TextBox x:Name="CensusKeyBox" Padding="4,3"/>
            <TextBlock FontSize="11" Foreground="#666666" Margin="0,3,0,12">
                <Hyperlink NavigateUri="https://api.census.gov/data/key_signup.html"
                           RequestNavigate="OnRequestNavigate">Get a free key</Hyperlink>
                <Run Text=" — Required for U.S. data"/>
            </TextBlock>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Gemini API key"/>
            <TextBox x:Name="GeminiKeyBox" Padding="4,3"/>
            <TextBlock FontSize="11" Foreground="#666666" Margin="0,3,0,12">
                <Hyperlink NavigateUri="https://aistudio.google.com/apikey"
                           RequestNavigate="OnRequestNavigate">Get a free key</Hyperlink>
                <Run Text=" — Required only for plain-language queries"/>
            </TextBlock>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Gemini model"/>
            <TextBox x:Name="GeminiModelBox" Padding="4,3"/>
            <TextBlock FontSize="11" Foreground="#666666" Margin="0,3,0,12"
                       Text="Default: gemini-2.5-flash-lite"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="84" Height="28" Margin="0,0,8,0"
                    IsDefault="True" Click="OnSaveClick"/>
            <Button Content="Cancel" Width="84" Height="28"
                    IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
